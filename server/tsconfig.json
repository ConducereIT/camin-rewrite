{
  "compilerOptions": {
    "moduleResolution": "node10",
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["es6", "dom", "ES2022"],
    "outDir": "build",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["**/*"]
}
